{
  "name": "priorra-next",
  "version": "1.0.0",
  "description": "PRIORRA Next — personal task/prioritization PWA. Offline-first (IndexedDB) with Firestore cloud sync.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.config.rules.mts"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "idb": "^8.0.3",
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.28.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
