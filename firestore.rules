// firestore.rules
//
// Enforces (Master Instruction section 19 / Architecture Proposal
// section 1.4):
//   - least-privilege access
//   - data partitioned under users/{uid}/... using request.auth.uid
//   - user A cannot read or write user B's data
//
// Deploy with: firebase deploy --only firestore:rules
// Test against the emulator before deploying — see
// tests/integration/firestore-rules/.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every user's data lives under users/{uid}/... . A request is
    // only ever allowed to touch its own uid's subtree — this single
    // condition is what makes cross-user access structurally
    // impossible, not merely discouraged.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
