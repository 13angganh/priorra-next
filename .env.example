# Firebase client config — all NEXT_PUBLIC_* values here are safe to
# expose to the browser bundle (Firebase's client config is not a
# secret; access control is enforced by firestore.rules, not by
# hiding this config).
#
# Get these values from: Firebase Console -> Project Settings ->
# General -> "Your apps" -> Web app -> SDK setup and configuration.
#
# If these are left unset, the app runs fully offline (IndexedDB
# only) with sync silently disabled — see
# src/lib/firebase/config.ts:isFirebaseConfigured().

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
